<UserControl x:Class="PokeStream.Connect.TeamSlot" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Focusable="False">
  <Border Background="{Binding Surface}" BorderBrush="{Binding Outline}" BorderThickness="1" CornerRadius="10" Margin="5" Padding="12,10" Height="133" AutomationProperties.Name="{Binding Summary}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel><TextBlock Text="{Binding Slot}" Foreground="#667080" FontSize="10" FontFamily="Consolas"/><TextBlock Text="{Binding State}" Foreground="{Binding StateBrush}" FontSize="10" HorizontalAlignment="Right"/></DockPanel>
      <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Grid><Image Source="{Binding Sprite}" Opacity="{Binding SpriteOpacity}" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality"/><Border Visibility="{Binding ItemVisibility}" Background="#282D38" BorderBrush="#484F5D" BorderThickness="1" CornerRadius="11" Width="23" Height="23" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,4" ToolTip="{Binding ItemName}"><Image Source="{Binding ItemSprite}" Width="21" Height="21"/></Border></Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0"><DockPanel LastChildFill="True"><Border DockPanel.Dock="Right" ToolTip="{Binding GenderLabel}" AutomationProperties.Name="{Binding GenderLabel}" Margin="5,0,0,0" CornerRadius="4" Padding="1" VerticalAlignment="Center"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="Background" Value="#256397"/><Style.Triggers><DataTrigger Binding="{Binding Gender}" Value="M"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding Gender}" Value="F"><Setter Property="Visibility" Value="Visible"/><Setter Property="Background" Value="#9B365E"/></DataTrigger></Style.Triggers></Style></Border.Style><Viewbox Width="18" Height="18"><Path Fill="White" Stretch="Uniform"><Path.Style><Style TargetType="Path"><Setter Property="Data" Value="M800-760v160q0 17-11.5 28.5T760-560q-17 0-28.5-11.5T720-600v-63L561-505q19 28 29 59.5t10 65.5q0 92-64 156t-156 64q-92 0-156-64t-64-156q0-92 64-156t156-64q33 0 65 9.5t59 29.5l159-159h-63q-17 0-28.5-11.5T560-760q0-17 11.5-28.5T600-800h160q17 0 28.5 11.5T800-760ZM380-520q-58 0-99 41t-41 99q0 58 41 99t99 41q58 0 99-41t41-99q0-58-41-99t-99-41Z"/><Style.Triggers><DataTrigger Binding="{Binding Gender}" Value="F"><Setter Property="Data" Value="M440-200h-40q-17 0-28.5-11.5T360-240q0-17 11.5-28.5T400-280h40v-84q-79-14-129.5-75.5T260-582q0-91 64.5-154.5T480-800q91 0 155.5 63.5T700-582q0 81-50.5 142.5T520-364v84h40q17 0 28.5 11.5T600-240q0 17-11.5 28.5T560-200h-40v40q0 17-11.5 28.5T480-120q-17 0-28.5-11.5T440-160v-40Zm40-240q58 0 99-41t41-99q0-58-41-99t-99-41q-58 0-99 41t-41 99q0 58 41 99t99 41Z"/></DataTrigger></Style.Triggers></Style></Path.Style></Path></Viewbox></Border><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></DockPanel><TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></StackPanel>
      </Grid>
      <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ProgressBar Value="{Binding HpPercent}" Foreground="{Binding HealthBrush}" Visibility="{Binding HealthVisibility}" VerticalAlignment="Center" Margin="0,0,10,0" AutomationProperties.Name="{Binding HealthText}"/><TextBlock Grid.Column="1" Text="{Binding HealthText}" Foreground="#ACB4C1" FontSize="10" FontFamily="Consolas"/>
      </Grid>
    </Grid>
  </Border>
</UserControl>

{
  "name": "pokestream",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "data:sync": "node scripts/sync-pokedex.mjs",
    "data:sprites": "node scripts/sync-sprites.mjs",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:pack": "npm run desktop:build && electron-builder --config desktop/app/electron-builder.yml --win portable --publish never",
    "dev:local": "node scripts/dev-local.mjs",
    "desktop:web-only": "node scripts/build-desktop.mjs --web-only",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "desktop:release": "npm run desktop:build && electron-builder --config desktop/app/electron-builder.yml --win portable --publish never",
    "desktop:publish": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/publish-release.ps1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/pixelify-sans": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "html-to-image": "1.11.13",
    "lucide-react": "1.46.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  },
  "main": "desktop/app/main.cjs",
  "description": "PokeStream Windows — Adventure, Connect, Theme Creator & Overlay Builder",
  "author": "JOYKIX",
  "license": "MIT",
  "launcherVersion": "1.0.0"
}
